# GEMINI_API_KEY: Required for Gemini AI Screen Proctoring
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication secret
JWT_SECRET="studysync-super-secret-jwt-key"

# Supabase Cloud Database (PostgreSQL)
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-service-role-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here" (optional, bypasses RLS)

# Application URL
APP_URL="http://localhost:3000"

# LiveKit Cloud (optional for cloud livekit rooms)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
